<?php

/**
 * @file
 * Install and update functions for File Gate.
 *
 * Status report findings live in \Drupal\file_gate\Hook\FileGateRequirements.
 */

use Drupal\file_gate\Plugin\GateMethod\Otp;
use Drupal\file_gate\Plugin\GateMethod\Token;
use Drupal\file_gate\Service\GrantInventory;

/**
 * Implements hook_uninstall().
 *
 * Core does not drop expirable key-value collections. Token hashes, OTP
 * rows, and grant-inventory / redemption records would otherwise remain.
 */
function file_gate_uninstall(): void {
  $factory = \Drupal::service('keyvalue.expirable');
  foreach ([
    Token::TOKEN_COLLECTION,
    Otp::STORE_COLLECTION,
    GrantInventory::META_COLLECTION,
    GrantInventory::FIELD_INDEX_COLLECTION,
    GrantInventory::REDEMPTION_COLLECTION,
  ] as $collection) {
    $factory->get($collection)->deleteAll();
  }
}

/**
 * Add download flood + require_acting_account defaults.
 */
function file_gate_update_10001(): void {
  $config = \Drupal::configFactory()->getEditable('file_gate.settings');
  if ($config->get('download_flood_limit') === NULL) {
    $config->set('download_flood_limit', 120);
  }
  if ($config->get('download_flood_window') === NULL) {
    $config->set('download_flood_window', 60);
  }
  if ($config->get('require_acting_account') === NULL) {
    $config->set('require_acting_account', FALSE);
  }
  $config->save();
}
