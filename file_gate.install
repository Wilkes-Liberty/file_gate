<?php

/**
 * @file
 * Install and requirements functions for File Gate.
 */

/**
 * Implements hook_requirements().
 *
 * Reports gated fields that are not on the private file system — a public
 * scheme is not a gate, so those files stay world-readable.
 */
function file_gate_requirements(string $phase): array {
  $requirements = [];
  if ($phase !== 'runtime') {
    return $requirements;
  }

  $offenders = [];
  $storages = \Drupal::entityTypeManager()
    ->getStorage('field_storage_config')
    ->loadMultiple();

  foreach ($storages as $storage) {
    if (!$storage->getThirdPartySetting('file_gate', 'gated', FALSE)) {
      continue;
    }
    $settings = $storage->getSettings();
    // No uri_scheme means the field type has no file system, so gating it is
    // meaningless rather than unsafe.
    if (!array_key_exists('uri_scheme', $settings)) {
      continue;
    }
    if ($settings['uri_scheme'] === 'private') {
      continue;
    }
    $offenders[] = $storage->id() . ' (' . (string) $settings['uri_scheme'] . ')';
  }

  if ($offenders !== []) {
    $requirements['file_gate_public_gated_fields'] = [
      'title' => t('File Gate: gated fields are not on the private file system'),
      'value' => t('@list', ['@list' => implode(', ', $offenders)]),
      'severity' => REQUIREMENT_ERROR,
      'description' => t('These fields are marked as gated but store files publicly, so the gate never runs and the files are readable by anyone with the URL. The configuration says they are protected and they are not. Change the field to the private file system — note that existing files are not moved by that change, so they must be re-uploaded or migrated before the gate covers them.'),
    ];
  }

  // Named secrets with material but no field scope can authenticate and still
  // mint nothing — surface that as ERROR so it is not a silent dead credential.
  /** @var \Drupal\file_gate\SecretRegistryInterface $secrets */
  $secrets = \Drupal::service('file_gate.secret_registry');
  $unscoped = [];
  foreach ($secrets->namedSecretIds() as $id) {
    if ($secrets->isNamedSecretUnscoped($id)) {
      $unscoped[] = $id;
    }
  }
  if ($unscoped !== []) {
    $requirements['file_gate_unscoped_named_secrets'] = [
      'title' => t('File Gate: named secrets with no field scope'),
      'value' => t('@list', ['@list' => implode(', ', $unscoped)]),
      'severity' => REQUIREMENT_ERROR,
      'description' => t('These secret ids have values in <code>$settings["file_gate.secrets"]</code> but no (or empty) entry under <code>secret_scopes</code>. A named secret with no scope can mint nothing (fail closed). Add field storage keys (entity_type.field_name) for each id, or remove the unused secret. The legacy <code>download_secret</code> without a key id remains whole-corpus for older installs.'),
    ];
  }

  return $requirements;
}

/**
 * Add download flood + require_acting_account defaults.
 */
function file_gate_update_10001(): void {
  $config = \Drupal::configFactory()->getEditable('file_gate.settings');
  if ($config->get('download_flood_limit') === NULL) {
    $config->set('download_flood_limit', 120);
  }
  if ($config->get('download_flood_window') === NULL) {
    $config->set('download_flood_window', 60);
  }
  if ($config->get('require_acting_account') === NULL) {
    $config->set('require_acting_account', FALSE);
  }
  $config->save();
}
