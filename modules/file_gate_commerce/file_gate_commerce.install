<?php

/**
 * @file
 * Install and update functions for File Gate Commerce.
 *
 * Status report findings live in
 * \Drupal\file_gate_commerce\Hook\FileGateRequirements.
 */

declare(strict_types=1);

use Drupal\Core\Hook\Attribute\LegacyRequirementsHook;
use Drupal\file_gate_commerce\Hook\FileGateRequirements;

/**
 * Implements hook_requirements() for Drupal 10.
 */
#[LegacyRequirementsHook]
function file_gate_commerce_requirements(string $phase): array {
  if ($phase !== 'runtime' || version_compare(\Drupal::VERSION, '11.2', '>=')) {
    return [];
  }
  return \Drupal::service(FileGateRequirements::class)->runtime();
}
