<?php

/**
 * @file
 * Gate access to private files with pluggable, decoupled-friendly methods.
 *
 * File Gate denies the raw /system/files path for gated private files and
 * delivers them instead through its own route after a gate method approves the
 * request. See README.md for the architecture and security model.
 */

declare(strict_types=1);

use Drupal\Core\Entity\EntityFormInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\field\FieldConfigInterface;
use Drupal\field\FieldStorageConfigInterface;

/**
 * Implements hook_help().
 */
function file_gate_help(string $route_name, RouteMatchInterface $route_match): ?string {
  switch ($route_name) {
    case 'help.page.file_gate':
    case 'file_gate.settings_form':
      $output = '';
      $output .= '<p>' . t('File Gate controls access to <em>private://</em> files. It denies the normal <code>/system/files</code> path for files a "gated" field references, and delivers them instead through its own route after a pluggable <em>gate method</em> approves the request.') . '</p>';
      $output .= '<p>' . t('Gating is configured per field: edit a private file or image field and enable "Gate access to these files". Delivery is fully front-end-agnostic — a trusted back end mints a short-lived signed URL (<code>POST /api/file-gate/mint</code>) which the visitor redeems (<code>GET /api/file-gate/download</code>).') . '</p>';
      $output .= '<p>' . t('The signing secret must be injected from the environment in settings.php and is never stored in configuration. While it is unset the module fails closed (every gated file is denied).') . '</p>';
      return $output;
  }
  return NULL;
}

/**
 * Implements hook_mail().
 *
 * Builds the one-time passcode email for the `otp` gate method. The code itself
 * is passed in params (never stored or logged in plaintext elsewhere).
 */
function file_gate_mail(string $key, array &$message, array $params): void {
  if ($key !== 'otp') {
    return;
  }
  $message['subject'] = t('Your one-time download passcode');
  $message['body'][] = t('Your passcode to download @filename is: @code', [
    '@filename' => $params['filename'] ?? t('your file'),
    '@code' => $params['code'] ?? '',
  ]);
  $message['body'][] = t('It expires in @minutes minutes and can be used once. If you did not request this, you can ignore this email.', [
    '@minutes' => $params['ttl_minutes'] ?? 10,
  ]);
}

/**
 * Implements hook_file_download().
 *
 * File Gate's role in this hook is narrow and defensive: DENY the raw
 * /system/files path for any private file that a gated field references, unless
 * the current user may bypass the gate (editors/operators holding the
 * "bypass file gate" permission). It never *grants* access here — authorized
 * delivery happens on the module's own /api/file-gate/download route, which
 * streams the file after validating the minted grant and does not invoke this
 * hook.
 *
 * Returning -1 vetoes core's permissive private-file access (any single -1 from
 * any module denies the download), which is exactly what closes the gap: core
 * would otherwise grant anonymous download whenever the referencing (published)
 * entity is viewable.
 */
function file_gate_file_download($uri) {
  // Only private-scheme files are gateable. Anything else is never our concern.
  if (\Drupal::service('stream_wrapper_manager')->getScheme($uri) !== 'private') {
    return NULL;
  }

  $file = \Drupal::service('file.repository')->loadByUri($uri);
  if ($file === NULL) {
    return NULL;
  }

  // Not referenced by a gated field ⇒ leave it to core (this preserves access
  // to ungated private files, e.g. profile documents).
  if (!\Drupal::service('file_gate.resolver')->isGated($file)) {
    return NULL;
  }

  // Gated. Editors/operators with the bypass permission keep normal admin-UI
  // downloads; everyone else is denied the raw path and must use a minted URL.
  if (\Drupal::currentUser()->hasPermission('bypass file gate')) {
    return NULL;
  }

  return -1;
}

/**
 * Implements hook_form_FORM_ID_alter() for the field config edit form.
 *
 * Adds the per-field gating controls the module is built around: a "Gate access
 * to these files" toggle and a gate-method picker. Gating lives on the field
 * storage third-party settings (so it travels with exported configuration), and
 * because a public file cannot be gated, enabling it forces the field's storage
 * to the private file system. Only file-based fields (those exposing a
 * uri_scheme storage setting) are altered.
 */
function file_gate_form_field_config_edit_form_alter(array &$form, FormStateInterface $form_state): void {
  $form_object = $form_state->getFormObject();
  if (!$form_object instanceof EntityFormInterface) {
    return;
  }
  $field_config = $form_object->getEntity();
  if (!$field_config instanceof FieldConfigInterface) {
    return;
  }
  $field_storage = $field_config->getFieldStorageDefinition();
  // Only file-based fields can be gated; gating requires private storage, which
  // is only meaningful where the field has a uri_scheme storage setting.
  if (!$field_storage instanceof FieldStorageConfigInterface || !array_key_exists('uri_scheme', $field_storage->getSettings())) {
    return;
  }

  $method_options = [];
  foreach (\Drupal::service('plugin.manager.file_gate.gate_method')->getDefinitions() as $id => $definition) {
    $method_options[$id] = $definition['label'] ?? $id;
  }

  $gated = (bool) $field_storage->getThirdPartySetting('file_gate', 'gated', FALSE);

  $form['file_gate'] = [
    '#type' => 'details',
    '#title' => t('File Gate'),
    '#open' => $gated,
    '#weight' => 10,
  ];
  $form['file_gate']['file_gate_gated'] = [
    '#type' => 'checkbox',
    '#title' => t('Gate access to these files'),
    // Flatten the value to the top level so it is easy to read in the submit
    // handler and to target from #states selectors.
    '#parents' => ['file_gate_gated'],
    '#default_value' => $gated,
    '#description' => t('Deny the normal <em>/system/files</em> path for this field’s private files and deliver them only through File Gate’s signed route after a gate method approves the request. Enabling this <strong>forces and locks the private file system</strong> for this field.'),
  ];
  $form['file_gate']['file_gate_method'] = [
    '#type' => 'select',
    '#title' => t('Gate method'),
    '#parents' => ['file_gate_method'],
    '#options' => $method_options,
    '#default_value' => $field_storage->getThirdPartySetting('file_gate', 'method') ?: 'signed_url',
    '#description' => t('How a request proves it passed the gate. The selected method’s options appear below.'),
    '#states' => [
      'visible' => [
        ':input[name="file_gate_gated"]' => ['checked' => TRUE],
      ],
    ],
  ];

  // Per-method settings. Render each method's own settings form, shown only
  // when gating is on and that method is selected. On submit, only the selected
  // method's values are read (see the submit handler). Fields are not marked
  // #required, because #states-hidden elements still validate server-side —
  // methods fail closed at runtime when misconfigured instead.
  $method_manager = \Drupal::service('plugin.manager.file_gate.gate_method');
  $current_method = $field_storage->getThirdPartySetting('file_gate', 'method') ?: 'signed_url';
  $current_settings = (array) $field_storage->getThirdPartySetting('file_gate', 'method_settings', []);
  $form['file_gate']['file_gate_settings'] = [
    '#type' => 'container',
    '#parents' => ['file_gate_settings'],
    '#tree' => TRUE,
  ];
  foreach ($method_options as $id => $label) {
    $method_settings = $id === $current_method ? $current_settings : [];
    $subform = $method_manager->createInstance($id, $method_settings)->fieldSettingsForm($method_settings);
    if (!$subform) {
      continue;
    }
    $form['file_gate']['file_gate_settings'][$id] = [
      '#type' => 'fieldset',
      '#title' => t('@label settings', ['@label' => $label]),
      '#states' => [
        'visible' => [
          ':input[name="file_gate_gated"]' => ['checked' => TRUE],
          ':input[name="file_gate_method"]' => ['value' => $id],
        ],
      ],
    ] + $subform;
  }

  // Reflect the private-storage lock in the UI when gating is enabled.
  // Enforcement is server-side in the submit handler, so this is a usability
  // signal (and does not fight core's own uri_scheme locking on fields with
  // data).
  if (isset($form['field_storage']['subform']['settings']['uri_scheme'])) {
    $form['field_storage']['subform']['settings']['uri_scheme']['#states']['disabled'][':input[name="file_gate_gated"]'] = ['checked' => TRUE];
    $form['field_storage']['subform']['settings']['uri_scheme']['#description'] = t('File Gate forces this to “Private” while gating is enabled for this field.');
  }

  $form['#validate'][] = '_file_gate_field_config_edit_form_validate';
  // Persist the gating settings onto the field storage after the field config
  // is saved. Done as an explicit, decoupled storage save so the settings are
  // reliably persisted regardless of core's storage-save path.
  $form['actions']['submit']['#submit'][] = '_file_gate_field_config_edit_form_submit';
}

/**
 * Validation handler for the gating controls on the field config edit form.
 *
 * Enabling gating converts the field to private storage; block that when the
 * field already stores data in a non-private scheme, because the storage scheme
 * cannot be changed once a field has data and the existing files would become
 * unreachable.
 */
function _file_gate_field_config_edit_form_validate(array &$form, FormStateInterface $form_state): void {
  if (!$form_state->getValue('file_gate_gated')) {
    return;
  }

  $method = (string) ($form_state->getValue('file_gate_method') ?: '');
  $options = $form['file_gate']['file_gate_method']['#options'] ?? [];
  if ($method === '' || !isset($options[$method])) {
    $form_state->setErrorByName('file_gate_method', t('Select a valid gate method.'));
    return;
  }

  $field_config = $form_state->getFormObject()->getEntity();
  $field_storage = $field_config->getFieldStorageDefinition();
  if ($field_storage->hasData() && $field_storage->getSetting('uri_scheme') !== 'private') {
    $form_state->setErrorByName('file_gate_gated', t('This field already stores files in the %scheme file system. Gating requires private storage, which cannot be changed once a field has data. Create a new private field to gate.', [
      '%scheme' => $field_storage->getSetting('uri_scheme'),
    ]));
  }
}

/**
 * Submit handler that persists the gating settings onto the field storage.
 */
function _file_gate_field_config_edit_form_submit(array &$form, FormStateInterface $form_state): void {
  $field_config = $form_state->getFormObject()->getEntity();
  // Re-load the field storage fresh so we persist onto the just-saved entity
  // and do not clobber concurrent changes from the main form flow.
  $field_storage = FieldStorageConfig::loadByName($field_config->getTargetEntityTypeId(), $field_config->getName());
  if ($field_storage === NULL) {
    return;
  }

  $gated = (bool) $form_state->getValue('file_gate_gated');
  $method = (string) ($form_state->getValue('file_gate_method') ?: 'signed_url');
  $changed = _file_gate_apply_field_gating($field_storage, $gated, $method);

  if ($gated) {
    // Persist the selected method's own settings, normalized by the plugin.
    $values = (array) ($form_state->getValue(['file_gate_settings', $method]) ?? []);
    $method_settings = \Drupal::service('plugin.manager.file_gate.gate_method')
      ->createInstance($method, [])
      ->fieldSettingsSubmit($values);
    if ($field_storage->getThirdPartySetting('file_gate', 'method_settings', []) !== $method_settings) {
      $field_storage->setThirdPartySetting('file_gate', 'method_settings', $method_settings);
      $changed = TRUE;
    }
  }
  else {
    if ($field_storage->getThirdPartySetting('file_gate', 'method_settings', []) !== []) {
      $field_storage->unsetThirdPartySetting('file_gate', 'method_settings');
      $changed = TRUE;
    }
  }

  if ($changed) {
    $field_storage->save();
    \Drupal::messenger()->addStatus($gated
      ? t('File Gate is now protecting %field; its files are stored privately and delivered only through the gated route.', ['%field' => $field_storage->getName()])
      : t('File Gate protection was removed from %field.', ['%field' => $field_storage->getName()]));
  }
}

/**
 * Applies (or removes) File Gate settings on a field storage.
 *
 * Extracted from the submit handler so the gating logic is unit-testable in
 * isolation. When gating is enabled it forces private storage — a public file
 * cannot be gated — and records the gate method; when disabled it removes the
 * gating third-party settings and leaves the storage scheme untouched.
 *
 * @param \Drupal\field\Entity\FieldStorageConfig $field_storage
 *   The field storage to mutate (not saved by this function).
 * @param bool $gated
 *   Whether the field should be gated.
 * @param string $method
 *   The gate method plugin id to record when gating is enabled.
 *
 * @return bool
 *   TRUE if the field storage was changed and needs saving; FALSE otherwise.
 */
function _file_gate_apply_field_gating(FieldStorageConfig $field_storage, bool $gated, string $method): bool {
  $changed = FALSE;

  if ($gated) {
    // Force private storage — a public file cannot be gated.
    if ($field_storage->getSetting('uri_scheme') !== 'private') {
      $field_storage->setSetting('uri_scheme', 'private');
      $changed = TRUE;
    }
    if (!$field_storage->getThirdPartySetting('file_gate', 'gated', FALSE)) {
      $field_storage->setThirdPartySetting('file_gate', 'gated', TRUE);
      $changed = TRUE;
    }
    if ($field_storage->getThirdPartySetting('file_gate', 'method') !== $method) {
      $field_storage->setThirdPartySetting('file_gate', 'method', $method);
      $changed = TRUE;
    }
  }
  elseif ($field_storage->getThirdPartySetting('file_gate', 'gated', FALSE)) {
    // Remove gating; leave the storage scheme as the operator now chooses.
    $field_storage->unsetThirdPartySetting('file_gate', 'gated');
    $field_storage->unsetThirdPartySetting('file_gate', 'method');
    $changed = TRUE;
  }

  return $changed;
}
